# Copy this file to .env and fill in your keys. Never commit .env or share it.

# Order in which providers are tried (comma separated): groq, gemini, ollama
LLM_PROVIDER_ORDER=groq,gemini,ollama

# Groq: one key (GROQ_API_KEY) or many (GROQ_API_KEY1 ... GROQ_API_KEY30)
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Gemini: quotas are per Google Cloud PROJECT, so make each key in a SEPARATE project
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_THINKING_BUDGET=0

# Ollama (local backup, no quota)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Tuning
LLM_TIMEOUT=30
# If every key is briefly rate-limited, wait up to this many seconds for one to recover
LLM_MAX_WAIT=25
LLM_OLLAMA_TIMEOUT=120
LLM_CACHE=1
# LLM_CACHE_PATH=.llm_cache.sqlite

# Embeddings (module 3): auto = real MiniLM model if installed, otherwise built-in fallback
EMBEDDER=auto

# Several keys are fine: GROQ_API_KEY1 ... GROQ_API_KEY30 and GEMINI_API_KEY1 ... GEMINI_API_KEY30.
# They take turns (round robin) and a rate-limited key is skipped while the next one answers.
# Groq limits are per ACCOUNT, Gemini limits per Google Cloud PROJECT: use one key per teammate/project.
LLM_ROTATE_KEYS=1

# ---------------------------------------------------------------- Module 5: server, sign-in, database
# dev      = no Firebase needed; the app signs in with a made-up name (testing ONLY, anyone can be anyone)
# firebase = real sign-in with Firebase Auth (use this at the event)
AUTH_MODE=dev
# json     = a local file (data/store.json); firebase = Realtime Database
STORE=json
# Needed when AUTH_MODE=firebase or STORE=firebase (see docs/02_FIREBASE_SETUP.md)
FIREBASE_CREDENTIALS=serviceAccountKey.json
FIREBASE_DATABASE_URL=
PORT=5000
